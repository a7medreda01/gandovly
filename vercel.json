{
  "version": 2,
  "headers": [
    {
      "source": "/(app-shell\\.html|index\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/preview",
      "destination": "/api/preview"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/preview"
    },
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/preview?id=:id"
    },
    {
      "source": "/menu",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview).*"
        }
      ],
      "destination": "/api/preview"
    },
    {
      "source": "/api/v1/:match*",
      "destination": "https://supermarket1.runasp.net/api/v1/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://supermarket1.runasp.net/uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ],
  "functions": {
    "api/preview.mjs": {
      "maxDuration": 30
    }
  },
  "buildCommand": "npm run build"
}
